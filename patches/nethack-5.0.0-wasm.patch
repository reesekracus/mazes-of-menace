+WASM_CFLAGS += -DDEV_RANDOM=\"/dev/urandom\"
+# Pocket Yendor: end-of-game dump log (path set by DUMPLOGFILE in sys/libnh/sysconf)
+WASM_CFLAGS += -DDUMPLOG
 WASM_TARGET_CFLAGS = -DCROSSCOMPILE_TARGET -DCROSS_TO_WASM
